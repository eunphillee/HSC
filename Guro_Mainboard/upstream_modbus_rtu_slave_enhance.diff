 diff --git a/Guro_Mainboard/Modbus/Src/modbus_rtu.c b/Guro_Mainboard/Modbus/Src/modbus_rtu.c
 --- a/Guro_Mainboard/Modbus/Src/modbus_rtu.c
+++ b/Guro_Mainboard/Modbus/Src/modbus_rtu.c
+/* Expected request length (slave+FC+payload+CRC). */
+size_t ModbusRTU_GetExpectedRequestLength(const uint8_t *frame, size_t len)
+{
+    if (len < 2) return 0;
+    switch (frame[1]) {
+    case 0x01: case 0x02: case 0x03: case 0x04: case 0x05: case 0x06: return 8;
+    case 0x0F: if (len < 7) return 0; return (size_t)(7 + (uint16_t)frame[6] + 2);
+    case 0x10: if (len < 6) return 0; return (size_t)(7 + ((uint16_t)((frame[4]<<8)|frame[5])*2) + 2);
+    default: return 0;
+    }
+}
